# Feed Unfucker settings. ./fu init copies this to state/config.env, and the
# agent changes single values with ./fu config set. You don't need to edit it.

# Where the digest goes. The agent's email tool (a Gmail or Outlook connector)
# sends it from your own account.
FU_EMAIL_TO=

# daily or weekly. Weekly digests go out on FU_WEEKLY_DAY.
FU_CADENCE=weekly
FU_WEEKLY_DAY=sunday

# Your timezone, like Europe/London. Blank means this computer's clock.
FU_TIMEZONE=

# Which feeds to read, comma separated: facebook, instagram or both.
FU_PLATFORMS=facebook,instagram

# Lets scheduled runs connect to Chrome without an approval click. Shown when
# you click the Playwright extension's icon.
PLAYWRIGHT_MCP_EXTENSION_TOKEN=

# Optional: send over SMTP instead of the agent's email tool. This embeds the
# photos so they never expire, but needs an app password, which you type in
# here yourself. Gmail: smtp.gmail.com, port 465, and an app password from
# https://myaccount.google.com/apppasswords.
FU_SMTP_HOST=
FU_SMTP_PORT=465
FU_SMTP_USER=
FU_SMTP_PASSWORD=
