# Feed Unfucker settings. ./fu init copies this to state/config.env.
# Fill it in yourself: the agent never needs to read your password.
# Any of these can also be set as environment variables (for cloud runs).

# Email is sent from your own account to yourself over SMTP.
# Gmail: smtp.gmail.com, port 465, and an app password from
# https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
# Fastmail: smtp.fastmail.com, 465. iCloud: smtp.mail.me.com, 587.
FU_SMTP_HOST=smtp.gmail.com
FU_SMTP_PORT=465
FU_SMTP_USER=
FU_SMTP_PASSWORD=
# Defaults to FU_SMTP_USER
FU_EMAIL_TO=

# daily or weekly. Weekly digests go out on FU_WEEKLY_DAY.
FU_CADENCE=weekly
FU_WEEKLY_DAY=sunday

# Your timezone, like Europe/London. Blank means this machine's clock,
# which is usually UTC on cloud machines.
FU_TIMEZONE=

# Which feeds to read, comma separated: facebook, instagram or both.
FU_PLATFORMS=facebook,instagram
